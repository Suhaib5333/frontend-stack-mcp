{
  "name": "frontend-stack-mcp",
  "version": "0.1.0",
  "description": "MCP server and Claude Code plugin: a frontend design pipeline plus a Playwright verify_page tool (screenshots, console errors, failed requests, overflow, axe-core) at mobile and desktop sizes.",
  "type": "module",
  "bin": {
    "frontend-stack-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suhaib5333/frontend-stack-mcp.git"
  },
  "bugs": "https://github.com/Suhaib5333/frontend-stack-mcp/issues",
  "homepage": "https://github.com/Suhaib5333/frontend-stack-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "playwright",
    "claude-code",
    "frontend",
    "design-system",
    "testing",
    "accessibility",
    "axe-core"
  ],
  "author": "Suhaib Rajab",
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "^1.56.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
